*.log

# Ambientes virtuais
.venv/
venv/
env/

# Estudo de rodadas reduzidas: .pyd variantes + parquets de ~3,9 GB cada
# (~38 GB no total). Sem esta linha, um `git add -A` tentou versionar tudo
# e lotou o disco (2026-09-13). Os scripts que regeneram vivem em
# scripts/reduced_rounds/ e scripts/patch_reduced_rounds.py.
build/

# Backups/downloads compactados (duplicam pastas já versionadas)
*.zip

# Sessão Claude Code (privado)
.claude/

