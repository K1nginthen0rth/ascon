src/crypto/Release/
*.obj
*.exe
*.pyd

# Repos C de referencia aninhados. NAO ha copia amalgamada em src/crypto/ --
# os _*_ref.c de la sao so o glue do cffi, sem nenhum simbolo dos algoritmos.
# Para reconstruir num clone limpo, nos commits/hashes fixados:
#   python scripts/vendor_sources.py --fetch
# (o comentario anterior afirmava o contrario; era falso -- auditoria 2026-08-24)
ascon-c/
gift-cofb/
grain-128aead/
sparkle/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
.autonomo_logs/

# Artefatos de build do LaTeX (dissertacao/, dissertacao_rasc/, template do
# seminário). Extensões exclusivas do LaTeX, seguras de ignorar em qualquer
# pasta; o PDF compilado só nas pastas de texto (docs/ tem PDFs de verdade).
